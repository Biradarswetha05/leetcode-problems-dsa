class Solution:
    def buddyStrings(self, s: str, goal: str) -> bool:
        n = len(s)
        if n != len(goal):
            return False
        
        if s == goal:
            return len(set(s)) < n
        
        diff = []
        for i in range(n):
            if s[i] != goal[i]:
                diff.append(i)
        
        m = len(diff)
        if m == 2:
            i, j = diff
            return s[i] == goal[j] and s[j] == goal[i]
        
        return False
        
