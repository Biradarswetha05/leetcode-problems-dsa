from typing import List
from functools import lru_cache
from bisect import bisect_left

class Solution:
    def maxWalls(self, robots: List[int], distance: List[int], walls: List[int]) -> int:
        # Step 1: sort robots with distances
        arr = sorted(zip(robots, distance))
        walls.sort()
        n = len(arr)

        @lru_cache(None)
        def dfs(i, nxt_dir):
            if i < 0:
                return 0

            pos, dist = arr[i]

            # -------- FIRE LEFT --------
            left = pos - dist
            if i > 0:
                left = max(left, arr[i - 1][0] + 1)

            l = bisect_left(walls, left)
            r = bisect_left(walls, pos + 1)
            left_count = r - l

            res_left = dfs(i - 1, 0) + left_count

            # -------- FIRE RIGHT --------
            right = pos + dist
            if i + 1 < n:
                if nxt_dir == 0:
                    # next robot fires LEFT → it may come closer
                    right = min(right, arr[i + 1][0] - arr[i + 1][1] - 1)
                else:
                    # next robot fires RIGHT → just stop before it
                    right = min(right, arr[i + 1][0] - 1)

            l = bisect_left(walls, pos)
            r = bisect_left(walls, right + 1)
            right_count = r - l

            res_right = dfs(i - 1, 1) + right_count

            return max(res_left, res_right)

        return dfs(n - 1, 1)
