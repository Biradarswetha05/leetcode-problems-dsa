class Solution:
    def areSimilar(self, mat: List[List[int]], k: int) -> bool:
        m, n = len(mat), len(mat[0])
        shift = k % n
        
        for i in range(m):
            row = mat[i]
            if i % 2 == 0:
                new_row = row[shift:] + row[:shift]
            else:
                new_row = row[-shift:] + row[:-shift]
            
            if new_row != row:
                return False
        
        return True
