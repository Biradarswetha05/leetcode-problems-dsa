class Solution:
    def maximumAmount(self, coins: List[List[int]]) -> int:
        m, n = len(coins), len(coins[0])
    
    # Initialize DP with -inf
        dp = [[[-float('inf')] * 3 for _ in range(n)] for _ in range(m)]
    
    # Base case (0,0)
        val = coins[0][0]
        dp[0][0][0] = val
        if val < 0:
            dp[0][0][1] = 0  # neutralize
    
        for i in range(m):
            for j in range(n):
                for k in range(3):
                    if dp[i][j][k] == -float('inf'):
                        continue
                
                    for di, dj in [(1, 0), (0, 1)]:
                        ni, nj = i + di, j + dj
                    
                        if ni < m and nj < n:
                            val = coins[ni][nj]
                        
                        # 1. Don't neutralize
                            dp[ni][nj][k] = max(dp[ni][nj][k],
                                            dp[i][j][k] + val)
                        
                        # 2. Neutralize (only if negative)
                            if val < 0 and k < 2:
                                dp[ni][nj][k+1] = max(dp[ni][nj][k+1],
                                                  dp[i][j][k])
    
        return max(dp[m-1][n-1])
