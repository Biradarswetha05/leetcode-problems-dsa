class Solution:
    def licenseKeyFormatting(self, s: str, k: int) -> str:
        s = s.replace('-', '').upper()
        n = len(s)
        first = n % k or k
        res = [s[:first]]
        
        for i in range(first, n, k):
            res.append(s[i:i+k])
        
        return '-'.join(res)
