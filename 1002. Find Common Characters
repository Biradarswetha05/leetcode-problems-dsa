class Solution:
    def commonChars(self, words: List[str]) -> List[str]:
        res = []
    
        for ch in words[0]:
            found = True
        
            for word in words[1:]:
                if ch not in word:
                    found = False
                    break
                else:
                    words[words.index(word)] = word.replace(ch, '', 1)
        
            if found:
                res.append(ch)
    
        return res
